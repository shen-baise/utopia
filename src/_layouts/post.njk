---
layout: base.njk
pageType: post
---
{% from "icon.njk" import icon %}
<article id="post" class="page-card">
  <div class="container post-content" id="article-container">
    <div class="post-meta-line">{{ icon("calendar") }}<time datetime="{{ date }}">{{ date | readableDate }}</time><span>·</span>{{ icon("tag") }}{% for tag in tags %}<a href="{{ ('/tags/#' + tag) | url }}">{{ tag }}</a>{% if not loop.last %}、{% endif %}{% endfor %}<span>·</span><span>总字数 {{ content | wordCount }}</span><span>·</span><span>阅读 {{ content | readingTime }} 分钟</span></div>
    {{ content | safe }}
  </div>
  <section class="post-copyright">
    <div><span>文章作者：</span><a href="{{ site.github }}" target="_blank" rel="noopener noreferrer">{{ site.author }}</a></div>
    <div><span>文章链接：</span><a href="{{ page.url | url }}">{{ site.url }}{{ page.url | url }}</a></div>
    <div><span>版权声明：</span>本博客所有文章除特别声明外，均采用 <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="noopener noreferrer">CC BY-NC-SA 4.0</a> 许可协议，转载请注明来源。</div>
  </section>
  <section class="post-reward" aria-label="赞助">
    <button class="reward-button" type="button">赞助</button>
    <div class="reward-main">
      <figure><img src="{{ '/img/wechat.png' | url }}" alt="微信赞助二维码"><figcaption>微信</figcaption></figure>
      <figure><img src="{{ '/img/alipay.jpg' | url }}" alt="支付宝赞助二维码"><figcaption>支付宝</figcaption></figure>
    </div>
  </section>
  {% include "comments.njk" %}
</article>
{% include "sidebar.njk" %}
